{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build-${presetName}/",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_DEBUG_POSTFIX": {
          "type": "STRING",
          "value": "d"
        },
        "VCPKG_MANIFEST_MODE": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "local",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_EXPORT_PACKAGE_REGISTRY": {
          "type": "BOOL",
          "value": "ON"
        },
        "VCPKG_MANIFEST_MODE": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "local-debug",
      "configurePreset": "local",
      "configuration": "Debug"
    },
    {
      "name": "local-release",
      "configurePreset": "local",
      "configuration": "Release"
    },
    {
      "name": "local-relwithdebinfo",
      "configurePreset": "local",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 10
      },
      "configurePreset": "default",
      "configuration": "Debug"
    },
    {
      "name": "local",
      "inherits": "debug",
      "configurePreset": "local",
      "configuration": "Debug"
    }
  ],
  "packagePresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "configurations": [
        "Debug", "RelWithDebInfo"
      ],
      "generators": [
        "RPM"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        {
          "type": "configure",
          "name": "default"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "build",
          "name": "debug"
        },
        {
          "type": "test",
          "name": "debug"
        }
      ]
    },
    {
      "name": "local",
      "steps": [
        {
          "type": "configure",
          "name": "local"
        },
        {
          "type": "build",
          "name": "local-release"
        },
        {
          "type": "build",
          "name": "local-relwithdebinfo"
        },
        {
          "type": "build",
          "name": "local-debug"
        },
        {
          "type": "test",
          "name": "local"
        }
      ]
    }
  ]
}
